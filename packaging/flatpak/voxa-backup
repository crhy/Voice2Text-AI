#!/bin/sh

# In-sandbox entry point for the Voxa backup/restore tool.
# The sandboxed home contains no app data; pass --home-dir (or back up to a
# location reachable via --filesystem=host) to point at the host's paths.
PYTHONPATH="/app/lib/voxa${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec python3 -m voxa.backup "$@"
